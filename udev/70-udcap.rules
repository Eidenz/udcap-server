# UDCAP VR glove receiver dongles.
#
# The dongles enumerate as a WCH CH340 USB-to-serial bridge (1a86:7523).
# These rules grant the local user access both to the raw USB device
# (needed by libusb/libusbp for enumeration + hotplug) and to the ttyUSB
# serial node (needed for the actual serial link), so no sudo/dialout is
# required and access survives unplug/replug.
#
# NOTE: CH340 is a generic chip with no per-unit serial, so this also matches
# any other CH340 device (e.g. ESP32/Arduino OpenGloves boards). On a personal
# dev machine that is harmless; tighten with ATTRS{serial}== if needed.

SUBSYSTEM=="usb", ATTR{idVendor}=="1a86", ATTR{idProduct}=="7523", TAG+="uaccess", MODE="0666"
SUBSYSTEM=="tty", SUBSYSTEMS=="usb", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", TAG+="uaccess", MODE="0666"
